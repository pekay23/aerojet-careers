# ── Neon (primary database) ──────────────────────────────────
# Shared with the aerojet-aviation app so both codebases read/write the same
# Neon database. Pooled URL for the app; DIRECT_URL for migrations/DDL.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxx-pooler.c-XX.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxx.c-XX.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── Local auth (replaces Supabase Auth) ───────────────────────
# Used to sign session JWTs. Keep secret; rotating it logs everyone out.
AUTH_SECRET="your-32-byte-random-secret-here"

# ── App ───────────────────────────────────────────────────────
EMAIL_FROM="careers@aerojet-aviation.com"
NEXT_PUBLIC_APP_URL="https://careers.aerojet-aviation.com"
RESEND_API_KEY="re_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Upstash Redis (optional) ────────────────────────────────────
# Login rate limiting. Falls back to in-memory if not set.
# Can be shared across aerojet-aviation projects.
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
