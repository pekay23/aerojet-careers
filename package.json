    "@tanstack/react-table": "^8.21.3",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.7.0",
    "next": "^16.2.2",
    "pg": "^8.22.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.7.0",
    "resend": "^6.10.0",
    "sonner": "^2.0.7",
