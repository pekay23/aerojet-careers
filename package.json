  "packageManager": "bun@1.3.14",
  "private": true,
  "description": "Aerojet Aviation Careers Portal — Job listings, applications, admin dashboard",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
